{
  "name": "@igmainc/vite-plugin-hono-dev",
  "version": "0.3.1",
  "description": "A Vite plugin that dynamically proxies matched requests to a standalone Hono backend in dev",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iGmainC/vite-plugin-hono-dev.git"
  },
  "homepage": "https://github.com/iGmainC/vite-plugin-hono-dev#readme",
  "bugs": {
    "url": "https://github.com/iGmainC/vite-plugin-hono-dev/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite",
    "hono",
    "proxy",
    "dynamic-proxy",
    "dev-server"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:tsup": "tsup",
    "build:bun": "bun build ./src/index.ts --format esm --outdir ./dist --target node --external vite --external hono --external @hono/node-server --external ws",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "test:smoke": "node ./scripts/smoke-test.mjs",
    "test:runtime:node": "node ./scripts/runtime-smoke-test.mjs",
    "test:runtime:bun": "bun ./scripts/runtime-smoke-test.mjs",
    "test:runtime": "bun run test:runtime:node && bun run test:runtime:bun",
    "test:smoke:matrix": "node ./scripts/smoke-test-matrix.mjs",
    "verify": "bun run typecheck && bun run build && bun run test:smoke && bun run test:runtime",
    "prepublishOnly": "bun run verify"
  },
  "peerDependencies": {
    "@hono/node-server": ">=1",
    "hono": ">=4",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/node-ws": "^1.3.1",
    "@types/node": "^24.10.13",
    "@types/ws": "^8.18.1",
    "hono": "^4.12.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "ws": "^8.21.2"
  }
}
